<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="Controlador"
      spacing="12"
      style="-fx-padding:15;">

    <Label text="SISTEMA DE CITAS MÉDICAS"
           style="-fx-font-size:18px; -fx-font-weight:bold;"/>

    <GridPane hgap="10" vgap="10">

        <Label text="Código"
               GridPane.rowIndex="0"
               GridPane.columnIndex="0"/>

        <TextField fx:id="txtCodigo"
                   promptText="Código"
                   GridPane.rowIndex="0"
                   GridPane.columnIndex="1"/>

        <Label text="Paciente"
               GridPane.rowIndex="0"
               GridPane.columnIndex="2"/>

        <TextField fx:id="txtPaciente"
                   promptText="Nombre"
                   GridPane.rowIndex="0"
                   GridPane.columnIndex="3"/>

        <Label text="Cédula"
               GridPane.rowIndex="1"
               GridPane.columnIndex="0"/>

        <TextField fx:id="txtCedula"
                   GridPane.rowIndex="1"
                   GridPane.columnIndex="1"/>

        <Label text="Teléfono"
               GridPane.rowIndex="1"
               GridPane.columnIndex="2"/>

        <TextField fx:id="txtTelefono"
                   GridPane.rowIndex="1"
                   GridPane.columnIndex="3"/>

        <Label text="Médico"
               GridPane.rowIndex="2"
               GridPane.columnIndex="0"/>

        <ComboBox fx:id="cbMedico"
                  prefWidth="170"
                  GridPane.rowIndex="2"
                  GridPane.columnIndex="1"/>

        <Label text="Especialidad"
               GridPane.rowIndex="2"
               GridPane.columnIndex="2"/>

        <ComboBox fx:id="cbEspecialidad"
                  prefWidth="170"
                  GridPane.rowIndex="2"
                  GridPane.columnIndex="3"/>

        <Label text="Fecha"
               GridPane.rowIndex="3"
               GridPane.columnIndex="0"/>

        <DatePicker fx:id="dpFecha"
                    GridPane.rowIndex="3"
                    GridPane.columnIndex="1"/>

        <Label text="Hora"
               GridPane.rowIndex="3"
               GridPane.columnIndex="2"/>

        <TextField fx:id="txtHora"
                   promptText="08:30"
                   GridPane.rowIndex="3"
                   GridPane.columnIndex="3"/>

        <Label text="Estado"
               GridPane.rowIndex="4"
               GridPane.columnIndex="0"/>

        <ComboBox fx:id="cbEstado"
                  GridPane.rowIndex="4"
                  GridPane.columnIndex="1"/>

        <Label text="Motivo"
               GridPane.rowIndex="5"
               GridPane.columnIndex="0"/>

        <TextArea fx:id="txtMotivo"
                  prefRowCount="3"
                  GridPane.rowIndex="5"
                  GridPane.columnIndex="1"
                  GridPane.columnSpan="3"/>

    </GridPane>

    <HBox spacing="10" alignment="CENTER">

        <Button text="Registrar"
                onAction="#registrar"/>

        <Button text="Cancelar cita"
                onAction="#cancelar"/>

        <Button text="Limpiar"
                onAction="#limpiar"/>

        <Button text="Guardar"
                onAction="#guardar"/>

        <Button text="Cargar"
                onAction="#cargar"/>

    </HBox>

    <TableView fx:id="tabla" prefHeight="320">

        <columns>

            <TableColumn fx:id="colCodigo"
                         text="Código"
                         prefWidth="80"/>

            <TableColumn fx:id="colPaciente"
                         text="Paciente"
                         prefWidth="170"/>

            <TableColumn fx:id="colMedico"
                         text="Médico"
                         prefWidth="130"/>

            <TableColumn fx:id="colEspecialidad"
                         text="Especialidad"
                         prefWidth="130"/>

            <TableColumn fx:id="colFecha"
                         text="Fecha"
                         prefWidth="100"/>

            <TableColumn fx:id="colHora"
                         text="Hora"
                         prefWidth="80"/>

            <TableColumn fx:id="colEstado"
                         text="Estado"
                         prefWidth="100"/>

        </columns>

    </TableView>

</VBox>