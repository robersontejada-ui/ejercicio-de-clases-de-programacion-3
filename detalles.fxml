<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="DetallesControlador"
      alignment="CENTER"
      spacing="12">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <children>

        <Label text="Datos del Estudiante"
               style="-fx-font-size:18px; -fx-font-weight:bold;"/>

        <HBox spacing="10">
            <children>
                <Label text="Nombre:"/>
                <Label fx:id="lblNombre"/>
            </children>
        </HBox>

        <HBox spacing="10">
            <children>
                <Label text="Apellido:"/>
                <Label fx:id="lblApellido"/>
            </children>
        </HBox>

        <HBox spacing="10">
            <children>
                <Label text="Edad:"/>
                <Label fx:id="lblEdad"/>
            </children>
        </HBox>

        <HBox spacing="10">
            <children>
                <Label text="Carrera:"/>
                <Label fx:id="lblCarrera"/>
            </children>
        </HBox>

        <Button text="Cerrar"
                onAction="#cerrar"/>

    </children>

</VBox>