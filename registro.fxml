<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="RegistroControlador"
      alignment="CENTER"
      spacing="12">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <children>

        <Label text="Registro de Estudiantes"
               style="-fx-font-size:18px; -fx-font-weight:bold;"/>

        <HBox spacing="10" alignment="CENTER_LEFT">
            <children>
                <Label text="Nombre"/>
                <TextField fx:id="txtNombre"
                           prefWidth="220"
                           promptText="Digite el nombre"/>
            </children>
        </HBox>

        <HBox spacing="10" alignment="CENTER_LEFT">
            <children>
                <Label text="Apellido"/>
                <TextField fx:id="txtApellido"
                           prefWidth="220"
                           promptText="Digite el apellido"/>
            </children>
        </HBox>

        <HBox spacing="10" alignment="CENTER_LEFT">
            <children>
                <Label text="Edad"/>
                <TextField fx:id="txtEdad"
                           prefWidth="80"
                           promptText="Edad"/>
            </children>
        </HBox>

        <HBox spacing="10" alignment="CENTER_LEFT">
            <children>
                <Label text="Carrera"/>
                <ComboBox fx:id="cmbCarrera"
                          prefWidth="220"/>
            </children>
        </HBox>

        <HBox spacing="15" alignment="CENTER">
            <children>

                <Button text="Registrar"
                        onAction="#registrar"/>

                <Button text="Limpiar"
                        onAction="#limpiar"/>

            </children>
        </HBox>

        <Label fx:id="lblMensaje"
               text="Complete los datos del estudiante."/>

    </children>

</VBox>